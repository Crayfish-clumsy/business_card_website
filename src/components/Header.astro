---
import Brand from './Brand.astro';
import { url } from '../config';
---
<header class="header shell">
  <Brand />
  <nav class="nav" aria-label="Основная навигация">
    <a href={url('/#directions')}>Направления</a>
    <a href={url('/#cases')}>Кейсы</a>
    <a href={url('/#process')}>Как работаем</a>
    <a href={url('/#contact')}>Контакты</a>
  </nav>
  <div class="header-actions">
    <button class="theme-toggle" type="button" aria-label="Переключить тему">
      <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">☾</span>
      <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">☀</span>
    </button>
    <a class="glass-btn glass-btn--small" href={url('/#contact')}>Обсудить проект</a>
  </div>
</header>
