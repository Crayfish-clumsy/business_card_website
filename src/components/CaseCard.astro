---
import type { CollectionEntry } from 'astro:content';
import CaseVisual from './CaseVisual.astro';
import { url } from '../config';

interface Props {
  entry: CollectionEntry<'cases'>;
  index: number;
}
const { entry, index } = Astro.props;
const { title, summary, tags, metrics, visual, year } = entry.data;
const lead = metrics[0];
---
<a class="case-card reveal" href={url(`/cases/${entry.id}/`)}>
  <div class="case-card__visual"><CaseVisual variant={visual} /></div>
  <p class="case-card__meta label">
    <span>{String(index + 1).padStart(2, '0')}</span>
    <span>{year}</span>
    <span>{tags.join(' · ')}</span>
  </p>
  <h3>{title}</h3>
  <p class="case-card__summary">{summary}</p>
  <div class="case-card__foot">
    <strong>{lead.value}</strong>
    <span>{lead.label}</span>
    <span class="case-card__arrow" aria-hidden="true">→</span>
  </div>
</a>
