---
import { getCollection } from 'astro:content';
import Brand from './Brand.astro';
import { SITE, url } from '../config';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="footer shell">
  <div class="footer-left">
    <Brand />
    <p>{SITE.tagline}. {SITE.city}.</p>
  </div>
  <div class="footer-links">
    <div>
      <span>Кейсы</span>
      {cases.map((c) => <a href={url(`/cases/${c.id}/`)}>{c.data.short}</a>)}
    </div>
    <div>
      <span>Студия</span>
      <a href={url('/#directions')}>Направления</a>
      <a href={url('/#process')}>Как работаем</a>
      <a href={url('/#contact')}>Контакты</a>
    </div>
    <div>
      <span>Связь</span>
      <a href={SITE.telegram} target="_blank" rel="noopener">Telegram</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href="#top">Наверх ↑</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} {SITE.name}</span>
  </div>
</footer>
