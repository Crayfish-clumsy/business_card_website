---
interface Props {
  variant: 'web' | 'kiosk' | 'vpn' | 'scheduler';
}
const { variant } = Astro.props;
---
<div class={`cv cv-${variant === 'scheduler' ? 'sched' : variant}`} aria-hidden="true">
  {variant === 'web' && (
    <div class="cv-panel">
      <header><b>Терапевт · Иванова А. С.</b><span>Пн, 14 окт</span></header>
      <div class="cv-slots">
        <span class="off">08:00</span><span>08:30</span><span class="off">09:00</span><span>09:30</span>
        <span>10:00</span><span class="on">10:30</span><span class="off">11:00</span><span>11:30</span>
        <span class="off">12:00</span><span>14:00</span><span>14:30</span><span class="off">15:00</span>
      </div>
      <div class="cv-lock">🔒 Слот за вами · 4:59</div>
    </div>
  )}
  {variant === 'kiosk' && (
    <>
      <div class="cv-status">● Офлайн-режим</div>
      <div class="cv-panel cv-screen">
        <span>ВАШ ТАЛОН</span>
        <b>A-042</b>
        <span>ОКНО 3</span>
        <i></i>
      </div>
      <div class="cv-ticket">ТАЛОН<br /><b>A-042</b><br />10:31 · окно 3</div>
    </>
  )}
  {variant === 'vpn' && (
    <div class="cv-net">
      <svg viewBox="0 0 300 170" preserveAspectRatio="none">
        <path class="dim" d="M20 140 C 90 130, 120 60, 150 85" />
        <path class="dim" d="M150 85 C 190 110, 230 140, 280 130" />
        <path d="M20 140 C 70 40, 200 20, 260 30" />
      </svg>
      <span class="cv-node on" style="left:7%;top:82%"><i></i>YOU</span>
      <span class="cv-node" style="left:93%;top:76%"><i></i>STO</span>
      <span class="cv-node on" style="left:87%;top:18%"><i></i>AMS</span>
      <span class="cv-shield cv-panel">TLS</span>
    </div>
  )}
  {variant === 'scheduler' && (
    <>
      <div class="cv-panel">
        <div class="cv-row">Цех 1<div class="cv-track"><b style="left:4%;width:30%"></b><b style="left:40%;width:22%"></b></div></div>
        <div class="cv-row">Цех 2<div class="cv-track"><b class="on" style="left:20%;width:38%"></b></div></div>
        <div class="cv-row">Сварка<div class="cv-track"><b style="left:2%;width:18%"></b><b class="warn" style="left:58%;width:26%"></b></div></div>
        <div class="cv-row">Станок 4<div class="cv-track"><b style="left:30%;width:50%"></b></div></div>
        <div class="cv-row">Склад<div class="cv-track"><b style="left:10%;width:16%"></b><b style="left:66%;width:28%"></b></div></div>
      </div>
      <div class="cv-cursor">Мария двигает задачу</div>
    </>
  )}
</div>
