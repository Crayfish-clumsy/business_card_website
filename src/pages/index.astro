---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { SITE, url } from '../config';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const byId = Object.fromEntries(cases.map((c) => [c.id, c]));

// Каждое направление подкреплено кейсом — без него это просто строчка в прайсе.
const directions = [
  {
    title: 'Веб и порталы',
    text: 'Сайты с бизнес-логикой, личные кабинеты, онлайн-запись и интеграции со старыми системами клиента.',
    caseId: 'clinic-booking',
  },
  {
    title: 'Десктоп и кассы самообслуживания',
    text: 'Кроссплатформенные приложения на Avalonia, работа с железом, офлайн-режим и удалённые обновления парка.',
    caseId: 'self-checkout',
  },
  {
    title: 'Сети и безопасность',
    text: 'VPN, защищённые каналы, инфраструктура как код, мониторинг и отказоустойчивость.',
    caseId: 'private-vpn',
  },
  {
    title: 'Внутренние системы',
    text: 'Планировщики, CRM, админки и дашборды, которые заменяют Excel и ручные сводки.',
    caseId: 'potok-scheduler',
  },
];

const steps = [
  { title: 'Разбор задачи', text: 'Созвон, погружение в процессы, интервью с будущими пользователями.', time: '1–2 недели' },
  { title: 'Прототип', text: 'Кликабельный макет и техническая архитектура. Фиксируем объём и сроки.', time: '2–3 недели' },
  { title: 'Разработка', text: 'Двухнедельные спринты с демо. Вы видите прогресс на стенде, а не в отчётах.', time: 'от 2 месяцев' },
  { title: 'Запуск и поддержка', text: 'Плавный выход в прод, мониторинг, обучение команды и развитие продукта.', time: 'постоянно' },
];
---
<Base>
  <section class="hero shell">
    <div class="hero-main">
      <p class="hero-kicker">{SITE.tagline}</p>
      <h1>Пишем софт там, где он встречается с&nbsp;железом, сетью и&nbsp;старыми системами.</h1>
      <p class="hero-lead">{SITE.description}</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="#contact">Обсудить проект</a>
        <a class="btn" href="#cases">Смотреть кейсы</a>
      </div>
    </div>

    <nav class="hero-index" aria-label="Последние проекты">
      <p class="label">Последние проекты</p>
      <ol>
        {cases.map((c) => (
          <li>
            <a href={url(`/cases/${c.id}/`)}>
              <span class="hero-index__title">{c.data.short}</span>
              <span class="hero-index__metric">
                <strong>{c.data.metrics[0].value}</strong>
                <span>{c.data.metrics[0].label}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <section class="section shell" id="directions">
    <div class="section-head">
      <h2>Что мы делаем</h2>
      <p>Небольшая команда инженеров, которая берёт задачу целиком: от аналитики и дизайна до инфраструктуры.</p>
    </div>
    <ul class="directions">
      {directions.map((d) => (
        <li class="direction">
          <h3>{d.title}</h3>
          <p>{d.text}</p>
          <a class="direction__case" href={url(`/cases/${d.caseId}/`)}>
            <span class="label">Кейс</span>
            {byId[d.caseId].data.short} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section shell" id="cases">
    <div class="section-head">
      <h2>Кейсы</h2>
      <p>Рассказываем не только что сделали, но и где было сложно: какие проблемы встретили и как их решили.</p>
    </div>
    <div class="cases">
      {cases.map((entry, i) => <CaseCard entry={entry} index={i} />)}
    </div>
  </section>

  <section class="section shell" id="process">
    <div class="section-head">
      <h2>Как работаем</h2>
      <p>Вы всегда знаете, что сделано, что в работе и сколько это стоит.</p>
    </div>
    <ol class="process">
      {steps.map((s, i) => (
        <li class="step">
          <div class="step__top label"><span>0{i + 1}</span><span>{s.time}</span></div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="contact shell" id="contact">
    <div>
      <h2>Есть задача — напишите.</h2>
      <p>Расскажите, что хотите сделать. В течение дня ответим, зададим вопросы и предложим, с чего начать.</p>
    </div>
    <ul class="contact-links">
      <li>
        <span class="label">Telegram</span>
        <a href={SITE.telegram} target="_blank" rel="noopener">{SITE.telegramLabel} <span aria-hidden="true">↗</span></a>
      </li>
      <li>
        <span class="label">Почта</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </li>
    </ul>
  </section>
</Base>
