---
import { getCollection, render } from 'astro:content';
import { url } from '../../config';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseVisual from '../../components/CaseVisual.astro';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'cases'>;
  next: CollectionEntry<'cases'>;
}
const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const toc = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  { id: 'challenges', text: 'Сложности' },
  { id: 'result', text: 'Результат' },
  { id: 'stack', text: 'Стек' },
];
---
<Base title={d.short} description={d.summary}>
  <div class="shell">
    <a class="back" href={url('/#cases')}>← Все кейсы</a>

    <section class="case-hero">
      <div>
        <h1>{d.title}</h1>
        <p class="hero-lead">{d.summary}</p>
        <dl class="case-meta">
          <div><dt class="label">Клиент</dt><dd>{d.client}</dd></div>
          <div><dt class="label">Год</dt><dd>{d.year}</dd></div>
          <div><dt class="label">Срок</dt><dd>{d.duration}</dd></div>
          <div><dt class="label">Направление</dt><dd>{d.tags.join(' · ')}</dd></div>
        </dl>
      </div>
      <div class="case-hero__visual"><CaseVisual variant={d.visual} /></div>
    </section>

    <section class="metrics" aria-label="Результаты в цифрах">
      {d.metrics.map((m) => (
        <div class="metric"><strong>{m.value}</strong><span>{m.label}</span></div>
      ))}
    </section>

    <div class="case-layout">
      <aside class="case-aside">
        <span class="label">Содержание</span>
        <nav aria-label="Содержание кейса">
          {toc.map((t) => <a href={`#${t.id}`} data-toc>{t.text}</a>)}
        </nav>
      </aside>

      <article class="prose">
        <Content />

        <h2 id="challenges">Сложности и как мы их решили</h2>
        <div class="challenges">
          {d.challenges.map((c, i) => (
            <section class="challenge reveal">
              <h3><span class="label">0{i + 1}</span>{c.title}</h3>
              <div class="challenge-cols">
                <div><p class="label">Проблема</p><p>{c.problem}</p></div>
                <div><p class="label">Решение</p><p>{c.solution}</p></div>
              </div>
            </section>
          ))}
        </div>

        <h2 id="result">Результат</h2>
        <p>{d.result}</p>

        <h2 id="stack">Стек</h2>
        <ul class="stack">{d.stack.map((s) => <li>{s}</li>)}</ul>
      </article>
    </div>

{next.id !== entry.id && (
    <a class="next-case" href={url(`/cases/${next.id}/`)}>
      <div>
        <span class="label">Следующий кейс</span>
        <h2>{next.data.title}</h2>
      </div>
      <span class="case-card__arrow" aria-hidden="true">→</span>
    </a>
    )}
  </div>
</Base>
